# Copie ce fichier en ".env" et renseigne ta cle API Anthropic.
# Cree une cle sur https://console.anthropic.com (Settings > API Keys).
ANTHROPIC_API_KEY=sk-ant-...

# --- Production uniquement (laisser vide en local) -------------------------
# Domaine de la plateforme : ce qui distingue acme.factures.example.com
# (client "acme") du domaine nu. Des qu'il est renseigne, les cookies de
# session passent en Secure (HTTPS obligatoire).
# APP_DOMAIN=factures.example.com

# Cle de signature des cookies de session. A generer une fois
# (python -c "import secrets; print(secrets.token_urlsafe(48))") et a garder :
# la changer deconnecte tout le monde.
# SESSION_SECRET=

# Ou vivent les donnees clients (bases SQLite + factures originales).
# A placer sur un volume sauvegarde.
# DATA_DIR=/var/lib/factures

# Taille maximale d'un envoi, en Mo (0 = sans limite).
# MAX_UPLOAD_MB=500

# Quota de stockage par defaut applique a chaque client, en Mo (0 = illimite).
# DEFAULT_STORAGE_QUOTA_MB=0
